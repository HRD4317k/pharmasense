# =============================================================================================
# PharmaSense configuration.  Copy this file to ".env" (same folder) and fill in what you want:
#
#       cp .env.example .env          (Windows:  copy .env.example .env)
#
# ".env" is git-ignored, so your keys never get committed. EVERYTHING BELOW IS OPTIONAL except
# that openFDA works much better with a key. Every service used is free for an ordinary person.
# Free-tier limits change over time; the page named next to each key is the authority.
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# 1. openFDA key  (recommended, free, 1 minute, no credit card)
#    Where:   https://open.fda.gov/apis/authentication/   -> enter your email -> the key arrives by email
#    Why:     the FAERS adverse-event reports and the FDA drug labels both come from openFDA.
#             Documented limits at the time of writing:  no key = 1,000 requests/day per IP;
#             with a key = 120,000 requests/day, both 240/minute. The fetcher and the live
#             "whole database" FAERS counts (16 requests per combination) are the heavy users.
# ---------------------------------------------------------------------------------------------
OPENFDA_API_KEY=your_openfda_key_here


# ---------------------------------------------------------------------------------------------
# 2. Contact email  (optional, but polite and recommended)
#    Sent only inside the User-Agent header of requests to the public APIs below, so their
#    operators can contact you if your usage ever causes a problem. It is never used for anything else.
# ---------------------------------------------------------------------------------------------
CONTACT_EMAIL=your_email_here


# ---------------------------------------------------------------------------------------------
# 3. Language model  (OPTIONAL - leave LLM_PROVIDER=none and the whole system still works)
#
#    Without a model, hypotheses, scores, evidence and reports come from deterministic rules and
#    cited sources only. With one, the model may (a) word the narrative and (b) propose EXTRA
#    hypotheses. Anything it writes is checked afterwards: every citation id must exist in the
#    retrieved evidence, and the model is never allowed to change a number.
#
#    LLM_PROVIDER = none | groq | gemini | openrouter | ollama     (pick ONE)
#
#    groq        free tier, no card.   Key:  https://console.groq.com/keys     (sign in -> "Create API Key")
#    gemini      free tier, no card.   Key:  https://aistudio.google.com/apikey (sign in with Google -> "Create API key")
#    openrouter  free models exist (model names ending in ":free").  Key: https://openrouter.ai/keys
#                You MUST set LLM_MODEL for openrouter, e.g. one of the ":free" models listed on https://openrouter.ai/models
#    ollama      runs on YOUR computer, no account and no key.
#                Install from https://ollama.com , then run once:  ollama pull llama3.1
#
#    Paste only the key for the provider you chose; the others can stay as they are.
# ---------------------------------------------------------------------------------------------
LLM_PROVIDER=none

GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional overrides. Defaults:  groq=llama-3.3-70b-versatile  gemini=gemini-2.5-flash  ollama=llama3.1
# (model names change; if a call fails with "model not found", check the provider's model list.)
# LLM_MODEL=
# LLM_BASE_URL=          # any other OpenAI-compatible endpoint
# LLM_API_KEY=           # generic alternative to the provider-specific keys above


# ---------------------------------------------------------------------------------------------
# 4. Caching  (optional)
#    Every API answer is cached on disk so repeated questions are instant and you stay far under
#    the rate limits. Delete the folder at any time to force fresh data.
# ---------------------------------------------------------------------------------------------
# CACHE_DIR=.cache
# CACHE_TTL_DAYS=14


# ---------------------------------------------------------------------------------------------
# NO KEY NEEDED (used automatically, free and open):
#    PubChem (structures)              https://pubchem.ncbi.nlm.nih.gov/docs/pug-rest
#    ChEMBL (targets, mechanisms)      https://www.ebi.ac.uk/chembl/        (data licence: CC BY-SA 3.0)
#    UniProt (proteins, Reactome links) https://rest.uniprot.org
#    Open Targets (mechanisms, safety) https://platform.opentargets.org
#    Europe PMC (literature)           https://europepmc.org/RestfulWebService
#                                      It indexes all of PubMed/MEDLINE, which is why NO NCBI/PubMed key is needed.
#    STRING (protein networks)         https://string-db.org
#    ClinicalTrials.gov (human studies) https://clinicaltrials.gov/data-api/api
#
# After filling this in, check that everything works on YOUR machine:
#       python -m pharmasense_ai doctor
# =============================================================================================
